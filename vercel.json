{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/alerts",
      "destination": "/scam-alerts",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/local-friend-ocean-claim",
      "destination": "/api/local-friend-ocean?action=claim"
    },
    {
      "source": "/api/local-friend-ocean-reply",
      "destination": "/api/local-friend-ocean?action=reply"
    },
    {
      "source": "/api/local-friend-ocean-reveal",
      "destination": "/api/local-friend-ocean?action=reveal"
    },
    {
      "source": "/api/push-register",
      "destination": "/api/push?action=register"
    },
    {
      "source": "/api/push-notify-event",
      "destination": "/api/push?action=notify"
    },
    {
      "source": "/__workspace",
      "destination": "https://banditour-workspace.vercel.app"
    },
    {
      "source": "/__workspace/:path*",
      "destination": "https://banditour-workspace.vercel.app/:path*"
    },
    {
      "source": "/hotel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api\\/|__workspace(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
